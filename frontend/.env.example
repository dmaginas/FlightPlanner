# OpenAIP — airport search API (third-party, unrelated to backend selection)
VITE_OPENAIP_BASE_URL=https://api.core.openaip.net/api
VITE_OPENAIP_API_KEY=your_openaip_api_key_here

# ── Backend selection ─────────────────────────────────────────────────────────
# Select which FlightPlanner backend the Vite frontend should use.
# Accepted values: node | aspnet
# Backend selection happens at build/start time only — there is no runtime UI switch.
VITE_API_BACKEND=aspnet

# Old Node.js/TypeScript backend (backend-node-archive), default port 3001
# Port derived from backend-node-archive/.env: PORT=3001
VITE_NODE_API_BASE_URL=http://localhost:3001

# New C#/ASP.NET backend (backend), default HTTPS port 5001 / HTTP port 5000
# Port derived from backend/FlightPlanner.Api/Properties/launchSettings.json
VITE_ASPNET_API_BASE_URL=https://localhost:5001

# Legacy variable — kept for backward compatibility with older .env files.
# New code prefers VITE_ASPNET_API_BASE_URL above.
VITE_API_BASE_URL=https://localhost:5001

# OpenWeatherMap — clouds tile layer
# Register at https://openweathermap.org/api → Free plan → "API keys" tab → copy the default key.
# The key activates within a few minutes of account creation. Without this key the CLOUDS
# layer toggle is hidden in the map controls.
VITE_OWM_API_KEY=your_owm_api_key_here
