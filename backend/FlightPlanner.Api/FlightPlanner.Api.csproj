<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.2</Version>
    <AssemblyVersion>0.2.2.0</AssemblyVersion>
    <FileVersion>0.2.2.0</FileVersion>
    <Description>FlightPlanner ASP.NET Core Backend — METAR proxy and static frontend serving</Description>
    <RootNamespace>FlightPlanner.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <UserSecretsId>flightplanner-api-secrets</UserSecretsId>
  </PropertyGroup>



  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaServices.Extensions" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="9.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="NavData\earth_awy.dat" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NavData\earth_fix.dat" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="NavData\earth_nav.dat" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
