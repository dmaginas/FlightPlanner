{
  "openapi": "3.0.4",
  "info": {
    "title": "FlightPlanner API",
    "description": "Backend-API für FlightPlanner (nur für Flugsimulation).\n\n**METAR-Proxy**: Ruft METAR-Daten serverseitig von AviationWeather ab, um den\nBrowser-CORS-Fehler zu umgehen. AviationWeather setzt keinen\nAccess-Control-Allow-Origin-Header, daher sind direkte Browser-Requests blockiert.\n\n**Kein API-Key** für AviationWeather erforderlich.",
    "version": "0.1.0"
  },
  "paths": {
    "/api/Health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Gibt den Servicestatus, den Namen und die Version des Backends zurück.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Metar": {
      "get": {
        "tags": [
          "Metar"
        ],
        "summary": "Ruft den rohen METAR-Text für einen Flughafen ab.",
        "parameters": [
          {
            "name": "icao",
            "in": "query",
            "description": "ICAO-Flughafencode — genau 4 alphanumerische Zeichen, z. B. EDDF.\r\nGroß-/Kleinschreibung wird ignoriert; der Code wird normalisiert.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/Routes": {
      "get": {
        "tags": [
          "Routes"
        ],
        "summary": "Searches for IFR flight plans between two airports.\r\nReturns the best match as selectedRoute plus up to 4 alternatives.",
        "parameters": [
          {
            "name": "departure",
            "in": "query",
            "description": "Departure airport ICAO code (e.g. EDDF).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "destination",
            "in": "query",
            "description": "Destination airport ICAO code (e.g. EGLL).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "aircraftType",
            "in": "query",
            "description": "ICAO aircraft type code (e.g. A320). Accepted for enrichment and future use;\r\nnot forwarded to the FPD API (not supported as a query parameter there).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cruisingAltitude",
            "in": "query",
            "description": "Requested cruising altitude in feet (e.g. 35000). Accepted for enrichment;\r\nnot forwarded to the FPD API.",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "routeType",
            "in": "query",
            "description": "Currently only \"IFR\" is supported.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RouteResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "502": {
            "description": "Bad Gateway",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlternativeRouteDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "routeText": {
            "type": "string",
            "nullable": true
          },
          "distanceNm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "updatedAt": {
            "type": "string",
            "nullable": true
          },
          "popularity": {
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Alternative route candidate (metadata only — no full waypoints)."
      },
      "ErrorResponse": {
        "required": [
          "details",
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Kurze, maschinenlesbare Fehlerbeschreibung.",
            "nullable": true
          },
          "details": {
            "type": "string",
            "description": "Ausführliche, benutzerlesbare Fehlerbeschreibung.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Standardisiertes JSON-Fehlerformat für API-Fehlerantworten."
      },
      "HealthResponse": {
        "required": [
          "name",
          "status",
          "version"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Servicestatus, immer \"ok\".",
            "nullable": true
          },
          "name": {
            "type": "string",
            "description": "Name des Backend-Dienstes.",
            "nullable": true
          },
          "version": {
            "type": "string",
            "description": "Aktuelle Backend-Version (aus Assembly-Metadaten).",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Antwortmodell für den Health-Check-Endpunkt GET /api/health."
      },
      "RouteResponse": {
        "type": "object",
        "properties": {
          "selectedRoute": {
            "$ref": "#/components/schemas/SelectedRouteDto"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AlternativeRouteDto"
            },
            "description": "Alternative routes (metadata only) for future UI selection.",
            "nullable": true
          },
          "warning": {
            "type": "string",
            "description": "Human-readable warning when the result is a fallback or partial.\r\nNull on fully successful external lookup.",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Top-level response from GET /api/routes."
      },
      "SelectedRouteDto": {
        "required": [
          "departure",
          "destination",
          "source"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "nullable": true
          },
          "departure": {
            "type": "string",
            "nullable": true
          },
          "destination": {
            "type": "string",
            "nullable": true
          },
          "aircraftType": {
            "type": "string",
            "nullable": true
          },
          "cruisingAltitude": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "routeType": {
            "type": "string",
            "nullable": true
          },
          "routeText": {
            "type": "string",
            "description": "Route string (waypoint idents separated by spaces), e.g. \"ANEKI UL9 KONAN SILVA\".",
            "nullable": true
          },
          "waypoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WaypointDto"
            },
            "nullable": true
          },
          "distanceNm": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "source": {
            "type": "string",
            "description": "\"flight-plan-database\" or \"local-fallback\".",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Primary route including all waypoints."
      },
      "WaypointDto": {
        "required": [
          "id"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "ICAO / fix identifier, e.g. \"EDDF\" or \"ANEKI\".",
            "nullable": true
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "lat": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "lon": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "type": {
            "type": "string",
            "description": "Normalised type: \"airport\", \"fix\", \"vor\", \"ndb\".",
            "nullable": true
          }
        },
        "additionalProperties": false,
        "description": "Single waypoint in the route."
      }
    }
  },
  "tags": [
    {
      "name": "Health",
      "description": "Health-Check-Endpunkt — GET /api/health"
    },
    {
      "name": "Metar",
      "description": "METAR-Proxy-Endpunkt — GET /api/metar?icao=EDDF\r\n            \r\nRuft METAR-Daten serverseitig von AviationWeather ab und liefert sie\r\nals rohen Text zurück. Browser können AviationWeather nicht direkt\r\nansprechen, da kein Access-Control-Allow-Origin-Header gesetzt wird.\r\nDieser Backend-Proxy umgeht diese CORS-Einschränkung."
    },
    {
      "name": "Routes",
      "description": "IFR Route Lookup — GET /api/routes\r\n            \r\nProxies route requests to the Flight Plan Database API, caches results\r\nserver-side (default 30 min), and maps the response into a stable\r\nfrontend-facing DTO.\r\n            \r\nThe Flight Plan Database API key is read from server configuration only\r\nand is never forwarded to or exposed in the frontend."
    }
  ]
}